frontend/vite.config.d.ts

# Environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/*.log
!logs/.gitkeep
tmp/
temp/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

