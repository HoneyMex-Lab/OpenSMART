# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
opensmart/backend/.venv/

# Backend runtime data
opensmart/backend/*.db
opensmart/backend/*.db-*
opensmart/backend/.env
opensmart/backend/.env.*
!opensmart/backend/.env.example

# Frontend dependencies and build output
node_modules/
opensmart/frontend/node_modules/
opensmart/frontend/dist/
opensmart/frontend/.vite/
opensmart/frontend/*.tsbuildinfo
opensmart/frontend/vite.config.js
opensmart/frontend/vite.config.d.ts

# Environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/*.log
!logs/.gitkeep
tmp/
temp/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Agent sessions
docs/agent-handoff/

# Local-only coding-agent runtime config
.opencode/
.agents/
opencode.json
opencode.jsonc

# Local-only coding-agent process files (never tracked)
/agent guidance file
/agent guidance file
/design notes

# OpenSMART-Standalone builder generated runtime artifacts
containers/OpenSMART-Standalone/**/volumes/data/**
!containers/OpenSMART-Standalone/**/volumes/data/.gitkeep
containers/OpenSMART-Standalone/**/*.ovpn
containers/OpenSMART-Standalone/**/*.key
containers/OpenSMART-Standalone/**/*.crt
containers/OpenSMART-Standalone/**/*.pem
containers/OpenSMART-Standalone/**/*.log
containers/OpenSMART-Standalone/**/*.pcap
containers/OpenSMART-Standalone/**/*.db
containers/OpenSMART-Standalone/**/*.sqlite*

# opensmart/containers/run generated runtime artifacts (same convention as
# OpenSMART-Standalone). Moved here from repo-root containers/run/ on
# 2026-07-05 — keep this in sync with that path.
opensmart/containers/run/**/volumes/data/**
!opensmart/containers/run/**/volumes/data/.gitkeep
# Same for volumes/state/ (network interface MTU + firewall apply
# commit-confirm state — see backend/app/network_config.py and firewall.py).
# Untracked-but-not-ignored here would get swept into `git stash -u` during
# a deploy, and files restored by `stash pop` end up owned by whichever user
# ran git (root, over SSH) instead of the app's own service user — this bit
# us live on the reference host (PermissionError writing confirm/cancel/pending
# markers after a deploy).
opensmart/containers/run/**/volumes/state/**
!opensmart/containers/run/**/volumes/state/.gitkeep
opensmart/containers/run/**/*.ovpn
opensmart/containers/run/**/*.key
opensmart/containers/run/**/*.crt
opensmart/containers/run/**/*.pem
opensmart/containers/run/**/*.log
opensmart/containers/run/**/*.pcap
opensmart/containers/run/**/*.db
opensmart/containers/run/**/*.sqlite*

# Persistent uv package cache for the opensmart container (see
# opensmart/containers/run/opensmart/docker-compose.yml) — lives inside the
# bind-mounted project directory so it survives container recreation.
/.uv-cache/

# Front-door proxy self-signed certificate (generated at runtime by the
# nginx init-certs one-off service)
opensmart/containers/run/nginx/certs/
