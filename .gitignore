# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
opensmart/backend/.venv/

# Backend runtime data
opensmart/backend/*.db
opensmart/backend/*.db-*
opensmart/backend/.env
opensmart/backend/.env.*
!opensmart/backend/.env.example

# Frontend dependencies and build output
node_modules/
opensmart/frontend/node_modules/
opensmart/frontend/dist/
opensmart/frontend/.vite/
opensmart/frontend/*.tsbuildinfo
opensmart/frontend/vite.config.js
opensmart/frontend/vite.config.d.ts

# Environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/*.log
!logs/.gitkeep
tmp/
temp/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Agent sessions
docs/agent-handoff/

# Local-only coding-agent runtime config
.opencode/
.agents/
opencode.json
opencode.jsonc

# Local-only coding-agent process files (never tracked)
/agent guidance file
/agent guidance file
/design notes

# OpenSMART-Standalone builder generated runtime artifacts
containers/OpenSMART-Standalone/**/volumes/data/**
!containers/OpenSMART-Standalone/**/volumes/data/.gitkeep
containers/OpenSMART-Standalone/**/*.ovpn
containers/OpenSMART-Standalone/**/*.key
containers/OpenSMART-Standalone/**/*.crt
containers/OpenSMART-Standalone/**/*.pem
containers/OpenSMART-Standalone/**/*.log
containers/OpenSMART-Standalone/**/*.pcap
containers/OpenSMART-Standalone/**/*.db
containers/OpenSMART-Standalone/**/*.sqlite*

# containers/run generated runtime artifacts (same convention as OpenSMART-Standalone)
containers/run/**/volumes/data/**
!containers/run/**/volumes/data/.gitkeep
containers/run/**/*.ovpn
containers/run/**/*.key
containers/run/**/*.crt
containers/run/**/*.pem
containers/run/**/*.log
containers/run/**/*.pcap
containers/run/**/*.db
containers/run/**/*.sqlite*
