# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
OpenSMART/backend/.venv/

# Backend runtime data
OpenSMART/backend/*.db
OpenSMART/backend/*.db-*
OpenSMART/backend/.env
OpenSMART/backend/.env.*
!OpenSMART/backend/.env.example

# Frontend dependencies and build output
node_modules/
OpenSMART/frontend/node_modules/
OpenSMART/frontend/dist/
OpenSMART/frontend/.vite/
OpenSMART/frontend/*.tsbuildinfo
OpenSMART/frontend/vite.config.js
OpenSMART/frontend/vite.config.d.ts

# Environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/*.log
!logs/.gitkeep
tmp/
temp/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Agent sessions
docs/agent-handoff/

# Local-only coding-agent runtime config
.opencode/
.agents/
opencode.json
opencode.jsonc
design notes

