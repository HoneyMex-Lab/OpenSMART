# OpenSMART OpenVPN - hardened server configuration
port 1194
proto udp
dev tun

ca   __PKI__/ca.crt
cert __PKI__/issued/server.crt
key  __PKI__/private/server.key
dh   none
tls-crypt __PKI__/ta.key
crl-verify __PKI__/crl.pem

topology subnet
server 10.20.0.0 255.255.255.0
ifconfig-pool-persist /data/log/ipp.txt

push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 1.1.1.1"
push "block-outside-dns"
keepalive 10 120

# --- Hardened crypto ---
data-ciphers AES-256-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-GCM
cipher AES-256-GCM
auth SHA256
tls-server
tls-version-min 1.2
# Pin classical TLS key-exchange groups. OpenSSL 3.5 defaults to the
# post-quantum hybrid X25519MLKEM768, whose ~1 KB key shares bloat the TLS
# handshake past what OpenVPN Connect (mobile) tolerates — desktop clients
# cope, mobile ones time out with "TLS key negotiation failed". Classical
# groups keep the handshake small and universally compatible.
tls-groups X25519:secp256r1:secp384r1
remote-cert-tls client

user nobody
group nogroup
persist-key
persist-tun

status /data/log/openvpn-status.log
verb 3
explicit-exit-notify 1
