client
dev tun
proto udp
remote __SERVER_IP__ 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
data-ciphers AES-256-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-GCM
tls-version-min 1.2
verb 3
# Per-client material (<ca>/<cert>/<key>/<tls-crypt>) is appended by make-client.sh
